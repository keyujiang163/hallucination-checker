# Hallucination Checker - example env
# Copy to .env and fill in. Server reads on startup.

# MiniMax LLM (OpenAI-compatible). Leave blank to use rule-based claim splitter.
LLM_MODEL=MiniMax-M3
LLM_API_KEY=

# Server
PORT=3737

# Search provider. One of: ddg (default), brave, wikipedia, tavily
# ddg: free, no key, but blocked in mainland China (DNS hijack)
# brave: needs API key (free 2000/month), global
# wikipedia: free, no key, blocked in mainland China
# tavily: needs API key, designed for AI fact-check
SEARCH_PROVIDER=ddg

# Provider API keys (only needed if you switch SEARCH_PROVIDER)
BRAVE_API_KEY=
TAVILY_API_KEY=