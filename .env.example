# Hallucination Checker - example env
# Copy to .env and fill in. Server reads on startup.

# LLM provider. One of: minimax (default), openai, anthropic, deepseek.
# Other provider entries are defined as an abstraction in server.js; only the selected
# one is actually invoked. DAY-1: only `minimax` is integration-tested.
LLM_PROVIDER=minimax

# MiniMax LLM (OpenAI-compatible). Leave blank to use rule-based claim splitter.
LLM_MODEL=MiniMax-M3
MINIMAX_API_KEY=

# Alternate-provider keys (only used if LLM_PROVIDER is switched):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional per-provider model overrides; providers also have built-in defaults.
# LLM_MODEL_ANTHROPIC=claude-3-5-sonnet-latest
# LLM_MODEL_OPENAI=gpt-4o-mini
# LLM_MODEL_DEEPSEEK=deepseek-chat

# Server
PORT=3737

# Search provider. One of: ddg (default), brave, wikipedia, tavily
# ddg: free, no key, but blocked in mainland China (DNS hijack)
# brave: needs API key (free 2000/month), global
# wikipedia: free, no key, blocked in mainland China
# tavily: needs API key, designed for AI fact-check
SEARCH_PROVIDER=ddg

# Provider API keys (only needed if you switch SEARCH_PROVIDER)
BRAVE_API_KEY=
TAVILY_API_KEY=

# Billing (Stripe)
# Leave blank for dev mode — /api/checkout/create-session will then return a stub URL.
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from `stripe listen --forward-to ...`
# Required for /api/webhook/stripe to accept real events.
STRIPE_WEBHOOK_SECRET=

# Public URL of this site (used for Stripe success_url / cancel_url).
SITE_URL=http://localhost:3737
